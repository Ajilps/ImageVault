# Core
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://image_upload:image_upload_local@localhost:5432/image_upload?schema=public
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12

# Business rules and validation limits
DEFAULT_IMAGE_QUOTA=5
SLOT_PACK_SIZE=5
SLOT_PACK_PRICE_INR=100
MAX_SLOT_PACKS_PER_ORDER=20
MAX_ADMIN_SLOT_ALLOCATION=1000
MAX_USER_IMAGE_QUOTA=100000
MAX_TAGS_PER_IMAGE=50
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
NAME_MAX_LENGTH=120
EMAIL_MAX_LENGTH=255
ADDRESS_MAX_LENGTH=500
PHONE_MIN_LENGTH=5
PHONE_MAX_LENGTH=40
URL_MAX_LENGTH=2048
FILE_NAME_MAX_LENGTH=255
OBJECT_KEY_MAX_LENGTH=2048
JSON_BODY_LIMIT_BYTES=1048576
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=20
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_MAX_TRACKED_CLIENTS=10000
QUOTA_TRANSACTION_MAX_RETRIES=3
NOTIFICATION_POLL_INTERVAL_MS=60000

# Provisioned accounts
# Copy these settings to the ignored .env file and set a unique email and secure password.
DEFAULT_PRODUCT_OWNER_NAME=Product Owner
DEFAULT_PRODUCT_OWNER_EMAIL=product-owner@example.com
DEFAULT_ACCOUNT_PASSWORD=P@ssw0rd1234
# Local S3-compatible storage (Docker MinIO)
STORAGE_PROVIDER=minio
AWS_REGION=us-east-1
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=image-uploads
MINIO_ACCESS_KEY=minio_local
MINIO_SECRET_KEY=minio_local_password
# Browser-visible endpoint used only when creating presigned upload/download URLs.
# For local Docker use http://localhost:9000; with Tunnel use https://storage.example.com.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_PRESIGN_EXPIRES_IN=900
MAX_FILE_SIZE=5242880
PUBLIC_SHARE_TOKEN_BYTES=32

# Production AWS S3 alternative
# STORAGE_PROVIDER=s3
# S3_BUCKET=your-private-production-bucket
# Change AWS_REGION above to the production bucket region (for example ap-south-1).
# AWS_ACCESS_KEY_ID=use-workload-credentials-where-possible
# AWS_SECRET_ACCESS_KEY=do-not-commit-a-secret

# Razorpay (optional until payments are configured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Web Push (generate a VAPID key pair; leave empty to disable push locally)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# When enabling push, use a subject such as: mailto:operations@example.com
